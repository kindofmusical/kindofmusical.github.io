---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
    <div class="bg-kom-blue py-12"></div>

    <section class="py-16 bg-white text-gray-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg mx-auto text-gray-800">
                <p class="font-bold mb-6">Contact / Socials links</p>
                
                <p class="mb-6">Want to get in touch?</p>
                
                <p class="mb-2">Email: <a href="mailto:kindofmusicalberlin@gmail.com" class="text-kom-blue underline">kindofmusicalberlin@gmail.com</a></p>
                <p class="mb-2">Instagram: <a href="https://instagram.com/kindofmusical_berlin" class="text-kom-blue underline" target="_blank" rel="noopener noreferrer">@kindofmusical_berlin</a></p>
                <p class="mb-2">YesTicket: <a href="https://www.yesticket.org/events/en/kind-of-musical/" class="text-kom-blue underline" target="_blank" rel="noopener noreferrer">https://www.yesticket.org/events/en/kind-of-musical/</a></p>
            </div>
        </div>
    </section>
</Layout>
